# Copy to .env.local and fill with YOUR Supabase project values.
# Never commit real keys. Only the anon (public) key belongs in frontend code.
# The service_role key must NEVER be used here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Own website server (optional alternative to Supabase) ---
# Build with `npm run build:server` and run `node server/index.mjs`:
# the server itself serves the site + API + realtime on http://<server-ip>/.
# VITE_API_BASE=same-origin is set by that build script automatically.
# Use an absolute value only if the API lives on another origin, e.g.:
# VITE_API_BASE=http://31.77.169.93:8080

# Groq settings are SERVER ONLY: use data/groq.env on the deployed server,
# loaded by systemd / Node; never place a real key in this file or a VITE_ variable.
# GROQ_API_KEY=<set privately on the server>
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TIMEOUT_MS=30000
